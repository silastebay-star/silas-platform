# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SILAS Platform"
NODE_ENV=development

# Authentication Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@silas.local

# File Upload Configuration
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true
NEXT_PUBLIC_ENABLE_GROUPS=true
NEXT_PUBLIC_ENABLE_FUND=true

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id
GOOGLE_SITE_VERIFICATION=your_google_site_verification

# Development Configuration
ENABLE_DEBUG_MODE=true
MOCK_EXTERNAL_SERVICES=true
SKIP_EMAIL_VERIFICATION=false
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/silastebay/cmgff34w9000v01pebcy24k4l

# VERCEL DEPLOYMENT INSTRUCTIONS:
# 1. Go to your Vercel project dashboard
# 2. Navigate to Settings > Environment Variables
# 3. Add each variable above with the exact name and value
# 4. Make sure to set them for Production, Preview, and Development environments

# Optional: AI/Embedding Service Configuration
# OPENAI_API_KEY=your_openai_api_key
# EMBEDDING_SERVICE_URL=your_embedding_service_url
