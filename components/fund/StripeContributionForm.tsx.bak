/**
 * Stripe Contribution Form
 * Handles secure payment processing for community fund contributions
 */

'use client'

import { useState } from 'react'
import { useStripe, useElements, PaymentElement } from '@stripe/react-stripe-js'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Textarea } from '@/components/ui/textarea'
import { Card, CardContent } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Loader2, CreditCard, Shield, Heart } from 'lucide-react'
import communityFundService from '@/lib/services/community-fund-service'
import { toast } from 'sonner'
import { cn } from '@/lib/utils'

interface StripeContributionFormProps {
  onSuccess: () => void
  className?: string
}

const SUGGESTED_AMOUNTS = [5, 10, 25, 50, 100]

export default function StripeContributionForm({ onSuccess, className }: StripeContributionFormProps) {
  const stripe = useStripe()
  const elements = useElements()
  
  const [amount, setAmount] = useState<number>(25)
  const [customAmount, setCustomAmount] = useState<string>('')
  const [description, setDescription] = useState('')
  const [processing, setProcessing] = useState(false)
  const [clientSecret, setClientSecret] = useState<string | null>(null)
  const [paymentIntentId, setPaymentIntentId] = useState<string | null>(null)
  const [step, setStep] = useState<'amount' | 'payment'>('amount')

  const handleAmountSelect = (selectedAmount: number) => {
    setAmount(selectedAmount)
    setCustomAmount('')
  }

  const handleCustomAmountChange = (value: string) => {
    setCustomAmount(value)
    const numValue = parseFloat(value)
    if (!isNaN(numValue) && numValue > 0) {
      setAmount(numValue)
    }
  }

  const handleContinueToPayment = async () => {
    if (amount < 0.5) {
      toast.error('Minimum contribution is £0.50')
      return
    }

    try {
      setProcessing(true)
      
      const { client_secret, payment_intent_id } = await communityFundService.createPaymentIntent({
        amount,
        description: description || 'Community fund contribution',
        metadata: {
          contribution_type: 'general'
        }
      })

      setClientSecret(client_secret)
      setPaymentIntentId(payment_intent_id)
      setStep('payment')
    } catch (error) {
      console.error('Error creating payment intent:', error)
      toast.error('Failed to initialize payment')
    } finally {
      setProcessing(false)
    }
  }

  const handleSubmitPayment = async (event: React.FormEvent) => {
    event.preventDefault()

    if (!stripe || !elements || !clientSecret) {
      return
    }

    try {
      setProcessing(true)

      const { error, paymentIntent } = await stripe.confirmPayment({
        elements,
        confirmParams: {
          return_url: `${window.location.origin}/fund/success`,
        },
        redirect: 'if_required'
      })

      if (error) {
        toast.error(error.message || 'Payment failed')
      } else if (paymentIntent && paymentIntent.status === 'succeeded') {
        // Confirm the contribution in our database
        await communityFundService.confirmContribution(
          paymentIntent.id,
          '', // Charge ID will be retrieved separately if needed
          amount,
          description
        )
        
        toast.success('Thank you for your contribution!')
        onSuccess()
      }
    } catch (error) {
      console.error('Error processing payment:', error)
      toast.error('Payment processing failed')
    } finally {
      setProcessing(false)
    }
  }

  const formatCurrency = (amount: number) => {
    return new Intl.NumberFormat('en-GB', {
      style: 'currency',
      currency: 'GBP'
    }).format(amount)
  }

  if (step === 'amount') {
    return (
      <div className={cn("space-y-6", className)}>
        {/* Header */}
        <div className="text-center space-y-2">
          <div className="flex items-center justify-center gap-2 text-green-600 mb-2">
            <Heart className="h-5 w-5" />
            <span className="font-medium">Support Your Community</span>
          </div>
          <p className="text-sm text-gray-600">
            Your contribution helps fund local projects and initiatives
          </p>
        </div>

        {/* Amount Selection */}
        <div className="space-y-4">
          <Label className="text-base font-medium">Choose Amount</Label>
          
          {/* Suggested Amounts */}
          <div className="grid grid-cols-3 gap-2">
            {SUGGESTED_AMOUNTS.map(suggestedAmount => (
              <Button
                key={suggestedAmount}
                variant={amount === suggestedAmount && !customAmount ? 'default' : 'outline'}
                size="default"
                onClick={() => handleAmountSelect(suggestedAmount)}
                className="h-12"
              >
                {formatCurrency(suggestedAmount)}
              </Button>
            ))}
          </div>

          {/* Custom Amount */}
          <div className="space-y-2">
            <Label htmlFor="custom-amount">Custom Amount</Label>
            <div className="relative">
              <span className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">
                £
              </span>
              <Input
                id="custom-amount"
                type="number"
                min="0.50"
                step="0.01"
                placeholder="0.00"
                value={customAmount}
                onChange={(e: React.ChangeEvent<HTMLInputElement>) => handleCustomAmountChange(e.target.value)}
                className="pl-8"
              />
            </div>
          </div>

          {/* Description */}
          <div className="space-y-2">
            <Label htmlFor="description">Message (Optional)</Label>
            <Textarea
              id="description"
              placeholder="Share why you're contributing..."
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              className="min-h-[80px]"
            />
          </div>
        </div>

        {/* Summary */}
        <Card className="bg-green-50 border-green-200">
          <CardContent className="p-4">
            <div className="flex justify-between items-center">
              <span className="font-medium">Your Contribution:</span>
              <span className="text-xl font-bold text-green-600">
                {formatCurrency(amount)}
              </span>
            </div>
            <div className="text-sm text-green-700 mt-2">
              100% goes directly to community projects
            </div>
          </CardContent>
        </Card>

        {/* Continue Button */}
        <Button
          variant="default"
          size="default"
          onClick={handleContinueToPayment}
          disabled={amount < 0.5 || processing}
          className="w-full h-12"
        >
          {processing ? (
            <>
              <Loader2 className="h-4 w-4 mr-2 animate-spin" />
              Preparing Payment...
            </>
          ) : (
            <>
              <CreditCard className="h-4 w-4 mr-2" />
              Continue to Payment
            </>
          )}
        </Button>

        {/* Security Notice */}
        <div className="flex items-center justify-center gap-2 text-xs text-gray-500">
          <Shield className="h-3 w-3" />
          <span>Secured by Stripe • Your payment information is encrypted</span>
        </div>
      </div>
    )
  }

  return (
    <div className={cn("space-y-6", className)}>
      {/* Header */}
      <div className="text-center space-y-2">
        <div className="flex items-center justify-center gap-2 text-green-600 mb-2">
          <CreditCard className="h-5 w-5" />
          <span className="font-medium">Complete Your Contribution</span>
        </div>
        <div className="text-2xl font-bold text-green-600">
          {formatCurrency(amount)}
        </div>
      </div>

      {/* Payment Form */}
      <form onSubmit={handleSubmitPayment} className="space-y-4">
        {clientSecret && (
          <div className="space-y-4">
            <PaymentElement 
              options={{
                layout: 'tabs'
              }}
            />
          </div>
        )}

        {/* Submit Button */}
        <Button
          type="submit"
          variant="default"
          size="default"
          disabled={!stripe || !elements || processing}
          className="w-full h-12"
        >
          {processing ? (
            <>
              <Loader2 className="h-4 w-4 mr-2 animate-spin" />
              Processing Payment...
            </>
          ) : (
            <>
              <Heart className="h-4 w-4 mr-2" />
              Contribute {formatCurrency(amount)}
            </>
          )}
        </Button>

        {/* Back Button */}
        <Button
          type="button"
          variant="outline"
          size="default"
          onClick={() => setStep('amount')}
          disabled={processing}
          className="w-full"
        >
          Back to Amount
        </Button>
      </form>

      {/* Security Notice */}
      <div className="flex items-center justify-center gap-2 text-xs text-gray-500">
        <Shield className="h-3 w-3" />
        <span>Secured by Stripe • Your payment information is encrypted</span>
      </div>

      {/* Benefits */}
      <div className="space-y-2 text-xs text-gray-600">
        <div className="font-medium">Your contribution helps:</div>
        <ul className="space-y-1 ml-4">
          <li>• Fund local community projects</li>
          <li>• Support environmental initiatives</li>
          <li>• Improve community infrastructure</li>
          <li>• Enable civic engagement tools</li>
        </ul>
      </div>
    </div>
  )
}
