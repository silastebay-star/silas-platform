fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/@mapbox+togeojson@0.16.2/node_modules/@mapbox/togeojson/togeojson" "$@"
else
  exec node  "$basedir/../.pnpm/@mapbox+togeojson@0.16.2/node_modules/@mapbox/togeojson/togeojson" "$@"
fi
